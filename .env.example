# Copy to .env and fill in your own values. `${VAR}` placeholders in
# config.yaml are resolved from the process environment or from this file.

# Milvus 2.x instance you control
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=

# OpenAI-compatible chat endpoint used for generation, judging and rewriting
LLM_BASE_URL=https://your-openai-compatible-endpoint/v1
LLM_API_KEY=
LLM_MODEL=

# Optional: reranker endpoint (leave empty and set reranker.enabled=false to skip)
RERANK_BASE_URL=

# Local BAAI/bge-m3 weights, used by the bge_m3_local embedding provider
BGE_M3_PATH=

# Optional overrides for any config.yaml field: HEPUKE__<SECTION>__<KEY>
# HEPUKE__SERVICE__PORT=42797

# Optional: point the DSL pipeline at your own corpus instead of data/corpus/
# DSL_CORPUS_DIR=
# DSL_SKILL_DIR=
